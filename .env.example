# Lab 8: змінні середовища сервера (усі перевіряє zod-схема в server/src/config.ts при старті).
# Скопіюйте в server/.env для локального запуску. Справжні значення для хостингу — у його
# сховищі секретів/змінних (Render → Environment), НІКОЛИ не в git і не в образі.

# порт і адреса (хостинг зазвичай сам задає PORT)
PORT=3000
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# звідки можна відкривати WebSocket (перевірка заголовка Origin), через кому
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# за проксі хостингу (Render, Fly) — true: IP клієнта береться з X-Forwarded-For
TRUST_PROXY=false
# ліміти (Lab 4, Lab 8)
MAX_CONNECTIONS_PER_IP=8
MAX_ROOMS=20
MAX_PLAYERS_PER_ROOM=8
MAX_PAYLOAD_BYTES=4096
JOIN_TIMEOUT_MS=5000
HEARTBEAT_MS=15000
RATE_LIMIT_PER_SEC=10
RATE_LIMIT_BURST=20
# штамп версії — підставляє збірка Docker (--build-arg GIT_SHA=...)
GIT_SHA=dev
