{
  "name": "@conter/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "assets": "node scripts/make-sprites.ts && node scripts/make-sounds.ts",
    "test": "node --test --test-timeout=20000 tests/*.test.ts",
    "typecheck": "tsc --noEmit -p .",
    "build:site": "tsc --noEmit -p . && vite build --base ./ --outDir ../site --emptyOutDir"
  },
  "devDependencies": {
    "vite": "^8.3.0"
  }
}
